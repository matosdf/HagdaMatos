# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — HM PRESENÇA & PERFORMANCE (VERCEL & META CLOUD API)
# ==============================================================================

# --- SUPABASE (BANCO DE DADOS POSTGRESQL) ---
# Encontrados em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://sua-instancia.supabase.co
# Use a Service Role Key no backend da Vercel (nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- META WHATSAPP BUSINESS CLOUD API (OFICIAL) ---
# Encontrados em: Meta Developers > Seu App > WhatsApp > API Setup
# ID do número de telefone que enviará as mensagens
META_PHONE_NUMBER_ID=109876543210987
# Token de Acesso do Sistema (Token Permanente gerado no Meta Business Manager)
META_WHATSAPP_TOKEN=EAAG...
# Versão da Graph API (padrão v21.0 ou superior)
META_GRAPH_VERSION=v21.0

# --- DESTINATÁRIO DO ALERTA INTERNO (HAGDA MATOS) ---
# Telefone que receberá os alertas imediatos de novos leads (formato DDI + DDD + Número, sem símbolos)
# Exemplo para (12) 99200-6109 no Brasil: 5512992006109
META_NOTIFY_PHONE=5512992006109

# --- TEMPLATES DE WHATSAPP (OPCIONAL / RECOMENDADO PARA INÍCIO ATIVO) ---
# Se você tiver templates pré-aprovados na Meta, informe os nomes aqui:
# Exemplo: META_TEMPLATE_ALERT_NAME=novo_lead_alerta
# Exemplo: META_TEMPLATE_LEAD_NAME=boas_vindas_diagnostico
META_TEMPLATE_ALERT_NAME=
META_TEMPLATE_LEAD_NAME=

# --- ÁREA EXCLUSIVA (NEXT.JS / SUPABASE AUTH) ---
# Preencha somente no ambiente local (.env.local ignorado) ou na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos antigos:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://www.hmpp.com.br
SUPABASE_SECRET_KEY=
REGISTRATION_ENABLED=false

# --- ASSINATURAS ASAAS ---
PAYMENT_PROVIDER=asaas
# URL atual oficial do Sandbox. Não utilizar a URL antiga do documento de contexto.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Defina o mesmo token (mínimo 24 caracteres) no painel de Webhooks do Asaas.
ASAAS_WEBHOOK_SECRET=
# As duas flags precisam ser habilitadas conscientemente; produção permanece bloqueada.
BILLING_ENABLED=false
ASAAS_ALLOW_PRODUCTION=false
# Preço aprovado: configuração comercial oficial em src/lib/product.ts. Variável mantida apenas como referência.
SUBSCRIPTION_MONTHLY_PRICE=129.00
# URL HTTPS dos termos aprovados da assinatura. Obrigatória para iniciar contratação.
SUBSCRIPTION_TERMS_URL=https://www.hmpp.com.br/termos
# Manter false até a próxima iteração financeira e a revisão dos documentos:
ASAAS_INTEGRATION_READY=false
LEGAL_DOCUMENTS_APPROVED=false
