# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — HM PRESENÇA & PERFORMANCE (VERCEL & META CLOUD API)
# ==============================================================================

# --- SUPABASE (BANCO DE DADOS POSTGRESQL) ---
# Encontrados em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://sua-instancia.supabase.co
# Use a Service Role Key no backend da Vercel (nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- META WHATSAPP BUSINESS CLOUD API (OFICIAL) ---
# Encontrados em: Meta Developers > Seu App > WhatsApp > API Setup
# ID do número de telefone que enviará as mensagens
META_PHONE_NUMBER_ID=109876543210987
# Token de Acesso do Sistema (Token Permanente gerado no Meta Business Manager)
META_WHATSAPP_TOKEN=EAAG...
# Versão da Graph API (padrão v21.0 ou superior)
META_GRAPH_VERSION=v21.0

# --- DESTINATÁRIO DO ALERTA INTERNO (HAGDA MATOS) ---
# Telefone que receberá os alertas imediatos de novos leads (formato DDI + DDD + Número, sem símbolos)
# Exemplo para (12) 99200-6109 no Brasil: 5512992006109
META_NOTIFY_PHONE=5512992006109

# --- TEMPLATES DE WHATSAPP (OPCIONAL / RECOMENDADO PARA INÍCIO ATIVO) ---
# Se você tiver templates pré-aprovados na Meta, informe os nomes aqui:
# Exemplo: META_TEMPLATE_ALERT_NAME=novo_lead_alerta
# Exemplo: META_TEMPLATE_LEAD_NAME=boas_vindas_diagnostico
META_TEMPLATE_ALERT_NAME=
META_TEMPLATE_LEAD_NAME=
